# Postgres (source). Host port 5442 avoids a clash with other local Postgres
# containers; the CDC pipeline talks to postgres:5432 over the docker network.
POSTGRES_USER=cdc
POSTGRES_PASSWORD=cdc_pw
POSTGRES_DB=source_db
POSTGRES_PORT=5442

# MSSQL (target). SA password must satisfy MSSQL complexity rules.
MSSQL_SA_PASSWORD=Cdc_Str0ng_Pw!
MSSQL_PORT=1433
MSSQL_DB=target_db
